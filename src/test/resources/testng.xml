<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="REST Assured API Test Suite">

    <listeners>
        <listener class-name="listeners.ExtentReportListener"/>
    </listeners>

    <test name="User API Tests">

        <classes>
            <class name="tests.ProductTest"/>
            <class name="tests.ProductDetailsTest"/>
            <class name="tests.CreateAccountTest"/>
            <class name="tests.ProductSerializationTest"/>
            <class name="tests.LoginTest"/>
            <class name="tests.ApiChainingTest"/>
            <class name="tests.GetApiTest"/>
        </classes>

    </test>

</suite>